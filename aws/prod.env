# Application settings
APP_NAME=pdex
ENVIRONMENT=prod
IMAGE_TAG=latest-prod
REPO_NAME=https://github.com/bcgov/pdex
REPO_BRANCH=prod

# Resource limits
CPU_REQUESTS=50m
CPU_LIMITS=250m
MEM_REQUESTS=128Mi
MEM_LIMITS=600Mi
MIN_REPLICAS=3
MAX_REPLICAS=20

# Secrets (to be stored in Azure Key Vault or Kubernetes Secret)
VAULT_ENV=secrets.env
NPM_ENV=prod